// {Entity} — Repository Interface
// Replace {Entity} with the actual entity name (PascalCase).

import type {
  {Entity},
  Create{Entity}Payload,
  Update{Entity}Payload,
  {Entity}Filter,
} from './{entity}.model';

export interface {Entity}Repository {
  getAll(filter?: {Entity}Filter): Promise<{Entity}[] | Error>;
  getById(id: string): Promise<{Entity} | Error>;
  create(payload: Create{Entity}Payload): Promise<{Entity} | Error>;
  update(id: string, payload: Update{Entity}Payload): Promise<{Entity} | Error>;
  remove(id: string): Promise<void | Error>;
}
